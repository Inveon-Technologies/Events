VITE_API_BASE_URL=http://localhost:3000
# Must match the backend's CASHFREE_ENV (see apps/api/.env.example) — a
# mismatch would render sandbox checkout against a production order or
# vice versa, both of which just fail outright rather than silently
# working. Defaults to sandbox in CheckoutPage.tsx when unset, for the
# same "fail toward doing nothing in a real account" reason as the
# backend default.
VITE_CASHFREE_MODE=sandbox
