VITE_API_BASE_URL=http://localhost:3000
# Only a fallback now: the API sends the Cashfree mode (sandbox or
# production) with every order, and the checkout uses that, so switching
# CASHFREE_ENV in the super admin portal needs no web rebuild. Used only
# if an older API doesn't send it. See docs/ops/CASHFREE.md.
VITE_CASHFREE_MODE=sandbox
