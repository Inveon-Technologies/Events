{
  "name": "@inveon-events/api",
  "version": "0.1.0",
  "private": true,
  "description": "Inveon Events backend API (Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "test:concurrency": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --testPathPattern=concurrency",
    "test:integration": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --testPathPattern=integration",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "loadtest:seed": "tsx --env-file-if-exists=.env src/db/loadtestSeed.ts",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@napi-rs/canvas": "^1.0.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "~5.76.11",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "sequelize": "^6.37.5",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
