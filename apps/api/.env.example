PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/inveon_events
REDIS_URL=redis://localhost:6379
JWT_SECRET=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
WHATSAPP_API_TOKEN=
# Gmail SMTP — generate an App Password at myaccount.google.com > Security
# > App passwords (requires 2-Step Verification enabled on the account).
# Used for booking confirmations (invoice + ticket QR codes attached) and
# organizer account emails (OTP, welcome). If unset, email sending is
# skipped with a warning rather than failing whatever triggered it — a
# booking must never fail just because its confirmation email couldn't
# be sent.
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Inveon Events
# Where event media (images/video, see eventMedia.ts) is written to and
# served from. In production this MUST point at a persistent Docker
# volume, not the container's own filesystem — anything written to a
# plain container path is lost on the next deploy. Defaults to
# ./uploads under this directory when unset, which is fine for local
# dev but never appropriate in production.
UPLOAD_DIR=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
