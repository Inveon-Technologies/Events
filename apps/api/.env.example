PORT=3000
# Structured JSON logs (pino): trace | debug | info | warn | error | fatal.
LOG_LEVEL=info
DATABASE_URL=postgres://user:password@localhost:5432/inveon_events
REDIS_URL=redis://localhost:6379
JWT_SECRET=
WHATSAPP_API_TOKEN=
# Cashfree Payment Gateway + Easy Split (vendor/marketplace split
# settlement) — see cashfreeClient.ts. Generate these from the Cashfree
# Merchant Dashboard. CASHFREE_ENV defaults to sandbox unless explicitly
# set to "production" — a missing/misconfigured value should fail
# toward "nothing happens in a real account," never toward silently
# hitting production.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
# Percentage of each paid booking's total kept by the platform; the
# remainder is split to the organizer's Cashfree vendor account. See
# cashfreeOrders.ts.
PLATFORM_FEE_PERCENT=5
# This API's own public base URL (e.g. https://events.inveontechnologies.in)
# — required to build the Cashfree webhook notify_url at order-creation
# time (see cashfreeOrders.ts). Cashfree calls this URL directly from
# their servers, so it must be publicly reachable, not localhost.
API_PUBLIC_URL=
# The public site's own origin, when it's served from a different origin
# than this API (e.g. https://events.inveontechnologies.in). Payment
# return URLs sent by the browser are only honored when they point at
# this origin or the API's own — see resolveReturnUrl in
# routes/publicBookings.ts. Optional when both share one origin.
WEB_PUBLIC_URL=
# How many reverse proxies sit in front of this API (Express
# `trust proxy`). Production has two: the shared front-door nginx (TLS)
# and this stack's own nginx. Governs req.protocol for generated URLs
# and req.ip for rate limiting — too high lets clients spoof their IP.
TRUST_PROXY_HOPS=2
# Gmail SMTP — generate an App Password at myaccount.google.com > Security
# > App passwords (requires 2-Step Verification enabled on the account).
# Used for booking confirmations (invoice + ticket QR codes attached) and
# organizer account emails (OTP, welcome). If unset, email sending is
# skipped with a warning rather than failing whatever triggered it — a
# booking must never fail just because its confirmation email couldn't
# be sent.
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Inveon Events
# Event media (images/video, see eventMedia.ts + s3Storage.ts) is
# stored in S3 when all four S3_* / AWS_REGION vars below are set, and
# falls back to local disk (UPLOAD_DIR) when any of them is missing —
# so local dev works with no AWS account at all. In production, S3 is
# the right choice (survives every deploy with no mounted volume
# needed); if using local disk instead, UPLOAD_DIR MUST point at a
# persistent Docker volume, not the container's own filesystem, or
# every upload is lost on the next deploy.
#
# The bucket can stay private: images are linked as /api/uploads/<key>
# and the API streams them from S3 with these credentials (it needs
# s3:GetObject, s3:PutObject and s3:DeleteObject on the bucket).
UPLOAD_DIR=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWS_REGION=

# Background job queue (BullMQ on REDIS_URL). On by default whenever
# REDIS_URL is set; set to false to run jobs inline instead.
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=5

# Postgres connections per API process (keep DB_POOL_MAX x processes
# under Postgres' max_connections, 100 by default).
DB_POOL_MAX=20

# Load testing a staging stack only (see loadtest/README.md) — NEVER in
# production.
# RATE_LIMITS_DISABLED=true

# WhatsApp notifications (booking confirmation, 3-hour reminder,
# cancellation, next-day thank-you). Off unless WHATSAPP_PROVIDER is set.
# Setup: docs/ops/WHATSAPP.md.
#   aisensy — AiSensy API campaigns (key from AiSensy → Manage → API Key)
#   meta    — Meta WhatsApp Cloud API directly
WHATSAPP_PROVIDER=
AISENSY_API_KEY=
# For WHATSAPP_PROVIDER=meta:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional: a different AiSensy campaign / Meta template name per message
# WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=booking_confirmation
# WHATSAPP_TEMPLATE_EVENT_REMINDER=event_reminder
# WHATSAPP_TEMPLATE_BOOKING_CANCELLED=booking_cancelled
# WHATSAPP_TEMPLATE_POST_EVENT_THANKS=post_event_thanks

# Signs the private ticket links sent on WhatsApp and email (/t/<token>).
# Falls back to JWT_SECRET. Changing it breaks every link already sent.
# TICKET_LINK_SECRET=
